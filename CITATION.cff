    given-names: Roberto
    orcid: "https://orcid.org/0000-0002-2495-6993"
version: 0.6.18
date-released: 2026-10-01
license: MIT
repository-code: "https://github.com/Symbulator/solver"
url: "https://symbulator.com"
keywords:
